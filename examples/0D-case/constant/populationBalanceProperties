FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       dictionary;
    location    "constant";
    object      populationBalanceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

populationBalanceModel univariate;

univariateCoeffs
{
    aggregation     off;
    aggregationKernel
    {
        aggregationKernel hydrodynamic;
        Ca              Ca [ 0 0 -1 0 0 0 0 ] 1;
    }
    breakup         off;
    breakupKernel
    {
        breakupKernel   exponential;
        expCoeff        expCoeff [ 0 -3 0 0 0 0 0 ] 0.01;
        Cb              Cb [ 0 0 -1 0 0 0 0 ] 0.1;
        daughterDistribution
        {
            daughterDistribution symmetricFragmentation;
        }
    }
    diffusionModel
    {
        diffusionModel  none;
    }
    growth          on;
    growthModel
    {
        growthModel     solution;
        minAbscissa     0;
        maxAbscissa     1e+15;
        kG              kG [ 0 1 -1 0 0 0 0 ] 2e-5;
        g               1;
        Eg              Eg [ 1 2 -2 0 -1 0 0 ] 30000;
        R               R [ 1 2 -2 -1 -1 0 0 ] 8.314;
        alphaG          alphaG [ 0 -1 0 0 0 0 0 ] 3e3;
        Lg              1;
        Csat0           Csat0 [ 1 -3 0 0 0 0 0 ] 30;
        dCsatdT         dCsatdT [ 1 -3 0 -1 0 0 0 ] 0.2;
        Tref            Tref [ 0 0 0 1 0 0 0 ] 298.15;
        solubility      polynomial 5((13.237 0) (-0.6255 1) (0.1024 2) (-0.0034 3) (4e-5 4));
        // solubility
        // {
        //     type  coded;
        //     code
        //     #{
        //         // Receives 'x' as the argument
        //         return
        //             4e-5*Foam::pow(x, 4)
        //             - 0.0034*Foam::pow(x, 3)
        //             + 0.1024*Foam::pow(x, 2)
        //             - 0.6255*x
        //             + 13.237;
        //     #};
        // }

        printCoeffs     on;
    }
    nucleation      off;
    nucleationModel
    {
        nucleationModel none;
    }
    odeCoeffs
    {
        ATol            1e-08;
        RTol            0.0001;
        fac             0.9;
        facMin          0.5;
        facMax          2;
        minLocalDt      1e-05;
    }
}


