FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       dictionary;
    location    "constant";
    object      populationBalanceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

populationBalanceModel univariate;

univariateCoeffs
{
    aggregation     off;
    aggregationKernel
    {
        aggregationKernel hydrodynamic;
        Ca              Ca [ 0 0 -1 0 0 0 0 ] 1;
    }
    breakup         off;
    breakupKernel
    {
        breakupKernel   exponential;
        expCoeff        expCoeff [ 0 -3 0 0 0 0 0 ] 0.01;
        Cb              Cb [ 0 0 -1 0 0 0 0 ] 0.1;
        daughterDistribution
        {
            daughterDistribution symmetricFragmentation;
        }
    }
    diffusionModel
    {
        diffusionModel  none;
    }
    growth          on;
    growthModel
    {
        growthModel     solution;
        minAbscissa     0;
        maxAbscissa     1e+15;
        kG              [m s^-1] 2e-5;
        g               1;
        Eg              [J mol^-1] 30000;
        alphaG          [m^-1] 3e3;
        Lg              1;

        printCoeffs     on;
    }
    nucleation      off;
    nucleationModel
    {
        nucleationModel none;
    }
    odeCoeffs
    {
        ATol            1e-08;
        RTol            0.0001;
        fac             0.9;
        facMin          0.5;
        facMax          2;
        minLocalDt      1e-05;
    }
}


