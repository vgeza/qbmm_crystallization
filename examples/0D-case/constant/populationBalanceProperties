FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       dictionary;
    location    "constant";
    object      populationBalanceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

populationBalanceModel univariate;

univariateCoeffs
{
    aggregation     off;
    aggregationKernel
    {
        aggregationKernel hydrodynamic;
        Ca              Ca [ 0 0 -1 0 0 0 0 ] 1;
    }
    breakup         off;
    breakupKernel
    {
        breakupKernel   exponential;
        expCoeff        expCoeff [ 0 -3 0 0 0 0 0 ] 0.01;
        Cb              Cb [ 0 0 -1 0 0 0 0 ] 0.1;
        daughterDistribution
        {
            daughterDistribution symmetricFragmentation;
        }
    }
    diffusionModel
    {
        diffusionModel  none;
    }
    growth          on;
    growthModel
    {
        growthModel     solution;
        minAbscissa     0;
        maxAbscissa     1e+15;

        // Kinetics of Y. C. Liu et al., Cryst. Growth Des. 2020, 20, 5235-5250, Table 10.;
        g 2.1742;
        Eg [J mol^-1] 10333.0;
        alphaG [m^-1] 11700.0;
        Lg 1.177;
        d 1.79373;
        Ed [J mol^-1] 0.0;
        alphaD [m^-1] 0.0;
        Ld 0;
        relativeSupersaturation 0;
        kG [m s^-1] 2.616666666666667e-09;
        kD [m s^-1] -7.356666666666667e-10;

        printCoeffs     on;
    }
    nucleation      off;
    nucleationModel
    {
        nucleationModel none;
    }
    odeCoeffs
    {
        ATol            1e-08;
        RTol            0.0001;
        fac             0.9;
        facMin          0.5;
        facMax          2;
        minLocalDt      1e-05;
    }
}


