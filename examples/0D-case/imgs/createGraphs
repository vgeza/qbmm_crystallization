#!/usr/bin/env python

import numpy as np
from os.path import join
import matplotlib.pyplot as plt


def load_data():
    inputs = {
        "T": "T",
        "C": "C",
        "Csat": "Csat",
        "m0": "moment.0.populationBalance",
        "m1": "moment.1.populationBalance",
        "m2": "moment.2.populationBalance",
        "m3": "moment.3.populationBalance",
    }
    data = {}
    for var, fname in inputs.items():
        print(var, fname)
        data["t"], data[var] = np.genfromtxt(
            join("..", "postProcessing", "probes", "0", fname),
            unpack=True,
        )
    return data


def load_data_ref():
    data = np.genfromtxt("../reference/moments.dat", names=True)
    return data


def plot_main():
    data = load_data()
    data_ref = load_data_ref()

    plot_results(data, data_ref)

    times = range(0, 9000 + 1, 900)
    plot_CSD(data, times)


def plot_results(data, data_ref):
    t = data["t"]
    t_ref = data_ref["t"]

    fig, axs = plt.subplots(2, 3, figsize=(16, 9))

    axs[0, 0].plot(t, data["T"] - 273.15, label="OpenFOAM")
    axs[0, 0].plot(t_ref, data_ref["T"] - 273.15, "--", label="Reference")
    axs[0, 0].set_ylabel("Temperature, ℃")

    axs[0, 1].plot(t, data["C"], label="OpenFOAM")
    axs[0, 1].plot(t_ref, data_ref["C"], "--", label="Reference")
    axs[0, 1].plot(t, data["Csat"], label="Saturation")
    axs[0, 1].set_ylabel("Concentration, kg/m$^3$")

    axs[0, 2].plot(t, data["m0"], label="OpenFOAM")
    axs[0, 2].plot(t_ref, data_ref["M0"], "--", label="Reference")
    axs[0, 2].set_ylabel("Moment $M_0$, m$^{-3}$")

    axs[1, 0].plot(t, data["m1"], label="OpenFOAM")
    axs[1, 0].plot(t_ref, data_ref["M1"], "--", label="Reference")
    axs[1, 0].set_ylabel("Moment $M_1$, m$^{-2}$")

    axs[1, 1].plot(t, data["m2"], label="OpenFOAM")
    axs[1, 1].plot(t_ref, data_ref["M2"], "--", label="Reference")
    axs[1, 1].set_ylabel("Moment $M_2$, m$^{-1}$")

    axs[1, 2].plot(t, data["m3"], label="OpenFOAM")
    axs[1, 2].plot(t_ref, data_ref["M3"], "--", label="Reference")
    axs[1, 2].set_ylabel("Moment $M_3$, -")

    for ax in axs.flat:
        ax.set_xlabel("Time, s")
        ax.grid(True)
        ax.legend()

    plt.savefig("postProcessing-all.pdf", bbox_inches="tight")


def plot_CSD(data, times):
    t = data["t"]
    m0 = data["m0"]

    fig, ax = plt.subplots(figsize=(10, 7))
    # ax.set_yscale("log")
    # ax.set_ylim(1e-6, 1e3)
    # ax.set_ylim(0, 100)

    for ti in times:
        fname = join(
            "..", "postProcessing", "populationBalanceProbes", f"{ti}", "quadrature"
        )
        x, y = np.genfromtxt(fname, unpack=True)
        scale = np.interp(ti, t, m0)
        plt.plot(x * 1e6, y / 1e6 * scale, label=f"OpenFOAM, t = {ti} s")

        fname = join("..", "reference", f"CSD-t{ti}.dat")
        x, y = np.genfromtxt(fname, unpack=True)
        plt.plot(
            x * 1e6,
            y / 1e6,
            "--",
            c="black",
            label="Reference" if ti == times[-1] else "",
        )

    ax.set_xlabel("Length, μm")
    ax.set_ylabel("Number density, m$^{-3}$ μm$^{-1}$")
    plt.legend()
    plt.grid(True)
    plt.savefig("postProcessing-CSD.pdf", bbox_inches="tight")


if __name__ == "__main__":
    plot_main()
