FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     crystalBuoyantPbePimpleFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         9000;

deltaT          1;

writeControl    runTime;

writeInterval   300;

purgeWrite      0;

writeFormat     binary;     // Use binary to avoid corruption of moments

writeCompression off;

writePrecision  8;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

suppressSolverInfo yes;

functions
{
    #include "probes"
}

libs
(
    "libcrystalGrowthModels.so"
    "libcrystalNucleationModels.so"
);

