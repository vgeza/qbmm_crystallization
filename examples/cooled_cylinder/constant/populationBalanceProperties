/*--------------------------------*- C++ -*----------------------------------*\
    Kinetics of Liu et al. (2020), Table 10.

    The paper reports rates per minute; the values below are divided by 60 so
    that the OpenFOAM time is in seconds:

        kG = 0.1570   um/min -> 2.616667e-3  um/s
        kS = 1.0002e6 1/min  -> 1.667e4      1/s
        kD = -0.04414 um/min -> -7.356667e-4 um/s
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      populationBalanceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

populationBalanceModel univariate;

univariateCoeffs
{
    aggregation     off;
    aggregationKernel
    {
        aggregationKernel hydrodynamic;
        Ca              Ca [ 0 0 -1 0 0 0 0 ] 1;
    }

    breakup         off;
    breakupKernel
    {
        breakupKernel   exponential;
        expCoeff        expCoeff [ 0 -3 0 0 0 0 0 ] 0.01;
        Cb              Cb [ 0 0 -1 0 0 0 0 ] 0.1;
        daughterDistribution
        {
            daughterDistribution symmetricFragmentation;
        }
    }

    diffusionModel
    {
        diffusionModel  none;
    }

    // ---- growth (GM5) and dissolution (DM1) --------------------------------
    growth          on;
    growthModel
    {
        growthModel     solution;
        minAbscissa     0;
        maxAbscissa     1e+15;

        kG              kG [ 0 1 -1 0 0 0 0 ] 2.616667e-3;
        g               2.1742;
        Eg              [J mol^-1] 10.333e3;
        alphaG          [m^-1] 0.0117;
        Lg              1.177;

        // dissolution, DM1: D = kD (Csat - C)^d   (kD < 0)
        kD              -7.356667e-4;
        d               1.79373;
        Ed              [J mol^-1] 0;
        alphaD          [m^-1] 0;
        Ld              0;
        // Crystals below this size stop dissolving: a moment method has no
        // sink for m0, so the abscissae must not be driven through zero.
        minAbscissaD    1.0;

        printCoeffs     on;
    }

    // ---- secondary nucleation (BM5) ---------------------------------------
    nucleation      on;
    nucleationModel
    {
        nucleationModel solution;

        // B = kS (C - Csat)^s exp(-Es/(R T)) M^Ms,  M = kv rhoc m3
        kS              1.667e4;
        s               1.0;
        Ms              2.0;
        Es              [J mol^-1] 26.57e3;

        rhoCrystal      1.2e-9;

        // The paper takes the nuclei size L0 -> 0
        nucleationSize  0;

        printCoeffs     on;
    }

    odeCoeffs
    {
        solveOde        false;
        ATol            1e-08;
        RTol            1e-04;
        fac             0.9;
        facMin          0.5;
        facMax          2;
        minLocalDt      1e-08;
    }
}

