#!/bin/sh
# Run the Liu et al. (2020) validation cases with crystalBatchPbeFoam.
#   ./Allrun               all cases val1..val4
#   ./Allrun val1 val3     only these
# Then: python3 analyze.py
cd "${0%/*}" || exit 1
. "$WM_PROJECT_DIR/bin/tools/RunFunctions"

cases=${*:-val1 val2 val3 val4}

for c in $cases; do
    echo "=== $c"
    (
        cd "$c" || exit 1
        runApplication blockMesh
        runApplication crystalBatchPbeFoam
    )
done
